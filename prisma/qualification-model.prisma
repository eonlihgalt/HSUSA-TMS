model Qualification {
  id          String              @id @default(uuid())
  name        String
  description String?
  status      QualificationStatus  @default(CURRENT)
  issuedAt    DateTime?
  expiresAt   DateTime?
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}
